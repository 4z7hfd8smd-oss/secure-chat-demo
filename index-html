<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Secure Chat</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #101827;
      color: white;
      text-align: center;
      padding: 25px;
    }
    .box {
      max-width: 400px;
      margin: 40px auto;
      padding: 20px;
      background: #1e293b;
      border-radius: 15px;
    }
    textarea, input, button {
      box-sizing: border-box;
      width: 100%;
      padding: 12px;
      margin: 8px 0;
      border-radius: 8px;
      border: none;
      font-size: 16px;
    }
    button {
      background: #22c55e;
      color: #07120a;
      font-weight: bold;
    }
    #result {
      overflow-wrap: anywhere;
      color: #86efac;
    }
  </style>
</head>
<body>
  <div class="box">
    <h1>🔐 Secure Chat</h1>
    <p>تجربة تشفير الرسائل</p>
    <textarea id="message" placeholder="اكتب رسالتك هنا"></textarea>
    <button onclick="encodeMessage()">تجهيز الرسالة</button>
    <h3>الرسالة الناتجة:</h3>
    <textarea id="result" readonly></textarea>
    <p>انسخ الرسالة وأرسلها للطرف الآخر للتجربة.</p>
  </div>
  <script>
    function encodeMessage() {
      const message = document.getElementById("message").value;
      const encoded = btoa(
        Array.from(new TextEncoder().encode(message),
          b => String.fromCharCode(b)).join("")
      );
      document.getElementById("result").value = encoded;
    }
  </script>
</body>
</html>
